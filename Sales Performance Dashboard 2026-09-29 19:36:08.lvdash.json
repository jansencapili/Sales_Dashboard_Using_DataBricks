        {
          "name": "dim_products_fact_sales",
          "from": "dim_products",
          "to": "fact_sales",
          "on": "`dim_products`.`product_key` = `fact_sales`.`product_key`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        }
      ]
    }
